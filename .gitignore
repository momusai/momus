/bin/
/dist/
.momus/
*.swp
.DS_Store
coverage.out

# docs site (Docusaurus)
website/node_modules/
website/build/
website/.docusaurus/
website/.cache-loader/

# npm wrapper: the platform binary is downloaded at install time
packages/momus-node/node_modules/
packages/momus-node/vendor/

# signing keys must never be committed
*.key

# internal operational notes: publishing checklist, launch drafts, and the
# generated project brief (its status figures are not for the public repo)
/Momus-Project-Brief.pdf
/HANDOVER.md
/LAUNCH-POSTS.md

# Scan output. Running Momus inside its own repo — which CI does, and which is
# the obvious way to try a change — otherwise leaves these untracked in the
# working tree and invites committing someone's scan results by accident.
/momus.sarif
/momus-report.html
/findings.json
/*.db
/diff.txt

# npm only belongs in packages/momus-node and website; a lockfile at the repo
# root means someone ran npm install in the wrong directory.
/package-lock.json
/node_modules/
